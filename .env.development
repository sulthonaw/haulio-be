# Application Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://127.0.0.1:3000
DS_API_URL=http://127.0.0.1:8080/api/v1
DS_IOT_SHARED_SECRET=

# Disabled by default. The local Mosquitto service is loopback-only and development-only.
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC_PREFIX=haulio/v1/telemetry
MQTT_CLIENT_ID=haulio-nest-telemetry-dev
MQTT_USERNAME=
MQTT_PASSWORD=
IOT_DEVICE_MAPPINGS=[]

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=haulio_dev
DB_SYNCHRONIZE=true
