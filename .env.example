# Application Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://127.0.0.1:3000
DS_API_URL=http://127.0.0.1:8080/api/v1
# Server-to-server secret. Set this to the DS IOT_SHARED_SECRET; never share it with a tracker.
DS_IOT_SHARED_SECRET=

# MQTT telemetry is disabled until a broker and device mapping are configured.
# Production must use mqtts:// plus broker ACLs/mTLS or equivalent device authentication.
MQTT_ENABLED=false
MQTT_URL=mqtts://broker.example.com:8883
MQTT_TOPIC_PREFIX=haulio/v1/telemetry
MQTT_CLIENT_ID=haulio-nest-telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
# Example shape only: [{"device_id":"gw-trk-01","truck_id":"TRK-01","secret":"per-device-secret"}]
IOT_DEVICE_MAPPINGS=[]

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=haulio_db
DB_SYNCHRONIZE=true
